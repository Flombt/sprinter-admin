# Variables du site Sprinter Admin (Annexe A du cahier des charges).
# Ne jamais committer de valeur réelle : saisir les valeurs dans Vercel (Production / Preview).

# URL du projet Supabase et clé PUBLIQUE uniquement (jamais de clé secrète).
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Secret HMAC du cookie de session du site (≥ 32 caractères aléatoires, serveur uniquement).
# Exemple de génération : node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Liste d'autorisation facultative (adresses séparées par des virgules).
ADMIN_ALLOWED_EMAILS=

# Niveau de journalisation (info par défaut en production).
LOG_LEVEL=info

# Réservé aux tests E2E locaux : jamais en production (la build échoue si activé).
# ADMIN_E2E_MOCK=1
