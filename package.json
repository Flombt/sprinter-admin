{
  "name": "sprinter-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "guard:secrets": "node scripts/check-no-secrets.mjs",
    "guard:bundle": "node scripts/check-no-secrets.mjs --bundle",
    "check:budget": "node scripts/check-js-budget.mjs",
    "test:performance": "node scripts/run-lighthouse.mjs",
    "mock:backend": "node e2e/mock-backend/server.ts",
    "check": "npm run guard:secrets && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "geist": "1.9.2",
    "get-nonce": "1.0.1",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "nuqs": "2.10.3",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
